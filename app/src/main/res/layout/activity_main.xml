<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/mini_player" />

    <!-- Mini Player -->
    <LinearLayout
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_above="@+id/bottom_navigation"
        android:orientation="vertical"
        android:background="@drawable/bg_mini_player"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/mini_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progress="35"
            android:progressDrawable="@drawable/progress_bar_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light">
                <ImageView
                    android:id="@+id/mini_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_music"
                    android:scaleType="centerCrop"
                    android:background="@color/accent_lilac" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/mini_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin reproducción"
                    android:fontFamily="@font/concert_one_regular"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/mini_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un track"
                    android:fontFamily="@font/concert_one_regular"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mini_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_prev"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/mini_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_play"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/mini_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorSurface"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemTextColor="@color/selector_nav_icon"
        android:elevation="0dp" />

    <!-- Top Border for Nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@+id/bottom_navigation"
        android:background="@color/border_light" />

</RelativeLayout>
