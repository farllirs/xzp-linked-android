<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginStart="12dp" />

            <ImageButton
                android:id="@+id/header_notif_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notifications"
                android:contentDescription="Notificaciones"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- URL Input Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?android:attr/colorSurface"
            android:padding="16dp"
            android:elevation="2dp"
>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pegar enlace"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/url_input"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="https://youtube.com/watch?v=..."
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary" />

                <ImageButton
                    android:id="@+id/paste_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_paste"
                    android:contentDescription="Pegar URL"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Platform Detection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
>

                <ImageView
                    android:id="@+id/platform_youtube"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_youtube"
                    android:contentDescription="YouTube"
                    android:alpha="0.5" />

                <ImageView
                    android:id="@+id/platform_tiktok"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_tiktok"
                    android:contentDescription="TikTok"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:id="@+id/platform_instagram"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_instagram"
                    android:contentDescription="Instagram"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:id="@+id/platform_x"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_x"
                    android:contentDescription="X"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Format Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
>

            <Button
                android:id="@+id/fmt_video"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Video"
                android:textStyle="bold"
                android:background="@drawable/bg_button_video"
                android:textColor="?android:attr/textColorPrimary" />

            <Button
                android:id="@+id/fmt_audio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Audio"
                android:textStyle="bold"
                android:background="@drawable/bg_button_audio"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Quality Selection -->
        <Spinner
            android:id="@+id/quality_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_spinner" />

        <!-- Download Button -->
        <Button
            android:id="@+id/download_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Descargar"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:textColor="@android:color/white" />

        <!-- Recent Downloads -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descargas recientes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/downloads_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>
