<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_primary"
                    android:padding="8dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_download"
                        app:tint="@color/text_primary_light" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XZP Linked"
                    style="@style/NeobrutalTitle"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/header_notif_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_notifications"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?android:attr/textColorPrimary"
                android:scaleType="centerInside" />
        </RelativeLayout>

        <!-- URL Input Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/NeobrutalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pegar enlace"
                    style="@style/NeobrutalBody"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/url_input"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="https://youtube.com/..."
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="12dp"
                        android:inputType="textUri"
                        android:fontFamily="@font/concert_one_regular"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/paste_btn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_paste"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="?android:attr/textColorPrimary"
                        android:scaleType="centerInside" />
                </LinearLayout>

                <!-- Platform Icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <ImageView
                        android:id="@+id/platform_youtube"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_youtube"
                        android:alpha="0.3"
                        android:layout_marginHorizontal="8dp" />

                    <ImageView
                        android:id="@+id/platform_tiktok"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_tiktok"
                        android:alpha="0.3"
                        android:layout_marginHorizontal="8dp" />

                    <ImageView
                        android:id="@+id/platform_instagram"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_instagram"
                        android:alpha="0.3"
                        android:layout_marginHorizontal="8dp" />

                    <ImageView
                        android:id="@+id/platform_x"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_x"
                        android:alpha="0.3"
                        android:layout_marginHorizontal="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Options Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/fmt_video"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Video"
                android:background="@drawable/bg_button_video"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/fmt_audio"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Audio"
                android:background="@drawable/bg_button_audio"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/quality_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/download_btn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Descargar"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/text_primary_light"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Recent Downloads Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descargas recientes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/downloads_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>
</ScrollView>
