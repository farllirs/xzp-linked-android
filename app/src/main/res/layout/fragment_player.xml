<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="20dp">

    <!-- Header / Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/filter_all_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Todos"
            android:background="@drawable/bg_button_video"
            android:textColor="?android:attr/textColorPrimary"
            android:paddingHorizontal="20dp" />

        <Button
            android:id="@+id/filter_folders_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Carpetas"
            android:background="@drawable/bg_button_audio"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

    <!-- Track List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tracks_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
