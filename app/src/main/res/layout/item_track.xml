<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/NeobrutalCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_light">
            <ImageView
                android:id="@+id/track_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_music"
                android:scaleType="centerInside"
                android:background="@color/accent_lilac"
                app:tint="@color/text_primary_light" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título del track"
                android:fontFamily="@font/concert_one_regular"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:fontFamily="@font/concert_one_regular"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/track_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:20"
            android:fontFamily="@font/concert_one_regular"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/track_more_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?android:attr/textColorPrimary"
            android:scaleType="centerInside" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
