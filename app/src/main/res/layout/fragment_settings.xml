<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Info Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/NeobrutalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/accent_cream">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/text_primary_light" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XZP Linked"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versión 1.0.0 · Build 2026"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_light" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apariencia"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/theme_light_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Claro"
                android:background="@drawable/bg_button_video"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/theme_dark_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Oscuro"
                android:background="@drawable/bg_button_audio"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginHorizontal="4dp" />

            <Button
                android:id="@+id/theme_system_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Sistema"
                android:background="@drawable/bg_button_primary"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Accent Color Palette -->
        <com.google.android.material.card.MaterialCardView
            style="@style/NeobrutalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color de acento"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige el color de identidad visual"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="16dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <View android:id="@+id/color_mint" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_mint" android:layout_margin="4dp" android:clickable="true" android:focusable="true" android:backgroundTint="@color/accent_mint" />
                    <View android:id="@+id/color_lilac" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_lilac" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_blue" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_blue" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_cream" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_cream" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_peach" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_peach" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_yellow" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_yellow" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_rose" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_rose" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_sage" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_sage" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_sky" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_sky" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    <View android:id="@+id/color_lavender" android:layout_width="40dp" android:layout_height="40dp" android:background="@color/accent_lavender" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Downloads Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descargas"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/NeobrutalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ruta de descarga"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/download_path_input"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="12dp"
                        android:textSize="12sp"
                        android:editable="false" />

                    <Button
                        android:id="@+id/browse_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Explorar"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggle_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solo con WiFi"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggle_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descarga en segundo plano" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Player Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reproductor"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/NeobrutalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggle_loop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reproducción en bucle" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggle_shuffle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aleatorio por defecto" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
