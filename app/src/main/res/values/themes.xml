<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Base (Claro) -->
    <style name="Theme.XZPLinked" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Colores Primarios (Por defecto Mint) -->
        <item name="colorPrimary">@color/accent_mint</item>
        <item name="colorPrimaryVariant">@color/accent_mint</item>
        <item name="colorSecondary">@color/accent_mint</item>
        <item name="colorSecondaryVariant">@color/accent_mint</item>

        <!-- Colores de Fondo -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>

        <!-- Colores de Texto -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Otros -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- Variantes de Color de Acento -->
    <style name="Theme.XZPLinked.Lilac">
        <item name="colorPrimary">@color/accent_lilac</item>
        <item name="colorPrimaryVariant">@color/accent_lilac</item>
        <item name="colorSecondary">@color/accent_lilac</item>
    </style>
    <style name="Theme.XZPLinked.Blue">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
    </style>
    <style name="Theme.XZPLinked.Cream">
        <item name="colorPrimary">@color/accent_cream</item>
        <item name="colorPrimaryVariant">@color/accent_cream</item>
        <item name="colorSecondary">@color/accent_cream</item>
    </style>
    <style name="Theme.XZPLinked.Peach">
        <item name="colorPrimary">@color/accent_peach</item>
        <item name="colorPrimaryVariant">@color/accent_peach</item>
        <item name="colorSecondary">@color/accent_peach</item>
    </style>
    <style name="Theme.XZPLinked.Yellow">
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorPrimaryVariant">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_yellow</item>
    </style>
    <style name="Theme.XZPLinked.Rose">
        <item name="colorPrimary">@color/accent_rose</item>
        <item name="colorPrimaryVariant">@color/accent_rose</item>
        <item name="colorSecondary">@color/accent_rose</item>
    </style>
    <style name="Theme.XZPLinked.Sage">
        <item name="colorPrimary">@color/accent_sage</item>
        <item name="colorPrimaryVariant">@color/accent_sage</item>
        <item name="colorSecondary">@color/accent_sage</item>
    </style>
    <style name="Theme.XZPLinked.Sky">
        <item name="colorPrimary">@color/accent_sky</item>
        <item name="colorPrimaryVariant">@color/accent_sky</item>
        <item name="colorSecondary">@color/accent_sky</item>
    </style>
    <style name="Theme.XZPLinked.Lavender">
        <item name="colorPrimary">@color/accent_lavender</item>
        <item name="colorPrimaryVariant">@color/accent_lavender</item>
        <item name="colorSecondary">@color/accent_lavender</item>
    </style>

    <!-- Estilos de Componentes Neobrutalistas -->
    <style name="NeobrutalButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/concert_one_regular</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="NeobrutalTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/bungee_regular</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="NeobrutalBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/concert_one_regular</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="NeobrutalCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="strokeColor">@color/border_light</item>
    </style>

    <style name="NeobrutalInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_sm</item>
        <item name="boxStrokeWidth">@dimen/border_width</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="android:textColorHint">@color/text_secondary_light</item>
    </style>
</resources>
