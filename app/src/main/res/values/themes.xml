<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Base (Claro) -->
    <style name="Theme.XZPLinked" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Colores Primarios -->
        <item name="colorPrimary">@color/accent_mint</item>
        <item name="colorPrimaryVariant">@color/accent_mint_dark</item>
        <item name="colorSecondary">@color/accent_mint</item>
        <item name="colorSecondaryVariant">@color/accent_mint_dark</item>

        <!-- Colores de Fondo -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>

        <!-- Colores de Texto -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Otros -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Tema Oscuro -->
    <style name="Theme.XZPLinked.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Colores Primarios -->
        <item name="colorPrimary">@color/accent_mint</item>
        <item name="colorPrimaryVariant">@color/accent_mint_dark</item>
        <item name="colorSecondary">@color/accent_mint</item>
        <item name="colorSecondaryVariant">@color/accent_mint_dark</item>

        <!-- Colores de Fondo -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>

        <!-- Colores de Texto -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Otros -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Colores Acentos (Material You) -->
    <style name="AccentColor" />

    <style name="AccentColor.Mint">
        <item name="android:colorAccent">@color/accent_mint</item>
    </style>

    <style name="AccentColor.Lilac">
        <item name="android:colorAccent">@color/accent_lilac</item>
    </style>

    <style name="AccentColor.Blue">
        <item name="android:colorAccent">@color/accent_blue</item>
    </style>

    <style name="AccentColor.Cream">
        <item name="android:colorAccent">@color/accent_cream</item>
    </style>

    <style name="AccentColor.Peach">
        <item name="android:colorAccent">@color/accent_peach</item>
    </style>

    <!-- Estilos de Componentes -->
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/border_color</item>
    </style>

    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">2dp</item>
    </style>
</resources>
